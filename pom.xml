<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

 <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-parent</artifactId>
        <version>200</version>
        <relativePath/>
    </parent>

    <groupId>dev.ikm.ike</groupId>
    <artifactId>rocks-kb</artifactId>
    <version>0.1.5-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Rocks KB</name>
    <description>Aggregator or placeholder for Rocks knowledge base modules.</description>

    <scm>
        <connection>scm:git:https://github.com/ikmdev/rocks-kb.git</connection>
        <developerConnection>scm:git:git@github.com:ikmdev/rocks-kb.git</developerConnection>
        <url>https://github.com/ikmdev/rocks-kb</url>
        <tag>HEAD</tag>
    </scm>

    <distributionManagement>
        <!-- Explicit <site> URL — see ike-parent/CLAUDE.md
             ("Inheriting projects MUST declare their own
             <distributionManagement><site>") and ike-issues#380/#383. -->
        <site>
            <id>ike-site</id>
            <url>https://ike.network/${project.artifactId}/</url>
        </site>
    </distributionManagement>

    <repositories>
        <repository>
            <id>tinkar-nexus</id>
            <url>https://nexus.tinkar.org/repository/ike-public/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <properties>
        <komet-bom.version>3.0.12-SNAPSHOT</komet-bom.version>
        <maven.compiler.enablePreview>true</maven.compiler.enablePreview>
        <java.version>27</java.version>
        <!-- The nid build check (tinkar-core nid-check, IKE-Network/ike-issues#1244): how it
             reports (error, or warning for a census), which classes may narrow a nid, and
             javac's cap on warnings, high enough that no warning is dropped. -->
        <nid-check.report>error</nid-check.report>
        <nid-check.allow>dev.ikm.ds.rocks.</nid-check.allow>
        <javac.maxwarns>10000</javac.maxwarns>
    </properties>

    <subprojects>
        <subproject>rocks-bench</subproject>
        <subproject>rocks-kb-engine</subproject>
        <subproject>kb-validation</subproject>
    </subprojects>


    <dependencyManagement>
        <dependencies>
            <!-- Tinkar dependencies -->
                <dependency>
                    <groupId>dev.ikm.komet</groupId>
                    <artifactId>komet-bom</artifactId>
                    <version>3.0.12-SNAPSHOT</version>
                    <type>pom</type>
                    <scope>import</scope>
                </dependency>
            <!-- The shared test logging configuration (log4j2-test.xml); a library ships none of its own. -->
            <dependency>
                        <groupId>dev.ikm.tinkar</groupId>
                        <artifactId>test-logging</artifactId>
                        <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                    <configuration>
                        <signer>bc</signer>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- The nid build check (tinkar-core nid-check, IKE-Network/ike-issues#1244). -->
                    <compilerArgs combine.children="append">
                        <arg>-Xplugin:NidCheck report=${nid-check.report} allow=${nid-check.allow}</arg>
                        <arg>-Xmaxwarns</arg>
                        <arg>${javac.maxwarns}</arg>
                        <arg>-Xmaxerrs</arg>
                        <arg>10000</arg>
                    </compilerArgs>
                    <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>dev.ikm.tinkar</groupId>
                            <artifactId>nid-check</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
